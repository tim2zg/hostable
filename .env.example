# Platform metadata; this is separate from hosted application databases.
DATABASE_URL=sqlite://hostable.db?mode=rwc
HOSTABLE_DATA_DIR=./hostable-data
PROXMOX_HOST=pve.example.internal
PROXMOX_NODE=pve
PROXMOX_TOKEN_ID=hostable@pve!manager
PROXMOX_TOKEN_SECRET=replace_me
# Trust the Proxmox cluster CA. Verification stays enabled.
PROXMOX_CA_CERT=/path/to/pve-root-ca.pem
PROXMOX_INSECURE_TLS=false
HOSTABLE_BIND=0.0.0.0
PORT=3000
HOSTABLE_DEFAULT_NETWORK=eth0
HOSTABLE_DEFAULT_BRIDGE=vmbr0
HOSTABLE_ALLOWED_ORIGINS=
# Enabled by install_in_lxc.sh for Linux amd64 systemd/OpenRC service installations.
# Automatic installation is opt-in under Settings > Portal updates.
# HOSTABLE_SELF_UPDATE_ENABLED=true
# Optional private registry CA certificate. OCI HTTPS verification stays enabled.
# HOSTABLE_OCI_CA_CERT=/path/to/registry-ca.pem
# For database guest provisioning: manager address allowed to authenticate as control role.
HOSTABLE_MANAGER_CIDR=192.168.1.10/32
# Optional pre-provisioned private SSH key, with a companion .pub file.
# HOSTABLE_GUEST_SSH_KEY=/etc/hostable/secrets/guest_ed25519
# Optional pinned guest known_hosts; otherwise first key is accepted and then pinned per instance.
# HOSTABLE_GUEST_KNOWN_HOSTS=/etc/hostable/secrets/known_hosts
# Use a separate mounted destination for disaster recovery.
# HOSTABLE_BACKUP_DIR=/mnt/hostable-backups
# Optional encryption of hosted database dumps. Import/trust this recipient in
# the manager service account's GPG keyring; decryption is required for restores.
# HOSTABLE_BACKUP_GPG_RECIPIENT=FULL_RECIPIENT_FINGERPRINT
# Optional node SSH for guest package/script updates, application logs and df.
# Use a dedicated key and verified, pre-pinned node host keys. No keys are installed automatically.
# HOSTABLE_NODE_SSH_ENDPOINTS='{"pve":{"host":"pve.example.internal","user":"root","port":22}}'
# HOSTABLE_NODE_SSH_KEY=/etc/hostable/secrets/node_ed25519
# HOSTABLE_NODE_KNOWN_HOSTS=/etc/hostable/secrets/node_known_hosts
# Optional CLI connection to a remote manager; defaults to loopback HTTP.
# HOSTABLE_MANAGER_URL=https://hostable.example.internal/api
# HOSTABLE_MANAGER_CA_CERT=/path/to/manager-ca.pem
# HOSTABLE_API_TOKEN=your_existing_manager_token
# Optional external HTTP ingress gateway. No local fallback gateway is provided.
SECUREWEB_GATEWAY_URL=
SECUREWEB_GATEWAY_TOKEN=
